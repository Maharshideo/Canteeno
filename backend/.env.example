# Canteeno Backend Environment Variables Example
PORT=5000
NODE_ENV=development
# Note: Prisma on MongoDB requires a replica set (standalone mongod --replSet rs0)
DATABASE_URL=mongodb://127.0.0.1:27018/canteeno?replicaSet=rs0&directConnection=true
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Cloudinary image upload (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
